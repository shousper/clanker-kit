{
  "name": "clanker-kit-tests",
  "private": true,
  "scripts": {
    "test": "bun test tests/static tests/stories tests/fixtures tests/utils",
    "test:evals:smoke": "RUN_EVALS=1 EVAL_TIER=smoke bun test tests/evals/activation.test.ts --timeout 120000",
    "test:evals": "RUN_EVALS=1 EVAL_TIER=full bun test tests/evals --concurrent --max-concurrency 4 --timeout 120000",
    "test:evals:parity": "RUN_EVALS=1 EVAL_TIER=parity HARNESSES=omp bun test tests/evals/activation.test.ts --concurrent --max-concurrency 4 --timeout 120000",
    "test:evals:standards": "RUN_EVALS=1 HARNESSES=${HARNESSES:-claude,omp} bun test tests/evals/code-standards.test.ts --concurrent --max-concurrency 4 --timeout 3600000",
    "test:evals:style": "RUN_EVALS=1 HARNESSES=${HARNESSES:-claude,omp} bun test tests/evals/style.test.ts --timeout 3600000",
    "test:all": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/mdast": "^4",
    "@types/unist": "^3",
    "remark-parse": "^11",
    "unified": "^11",
    "yaml": "^2"
  }
}
